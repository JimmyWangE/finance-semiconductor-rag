{
  "realm": "finance",
  "displayName": "金融半导体分析平台",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {"name": "admin", "description": "平台管理员"},
      {"name": "visitor", "description": "平台访客"}
    ]
  },
  "clients": [
    {
      "clientId": "finance-rag",
      "name": "金融半导体平台",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "@KEYCLOAK_CLIENT_SECRET@",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "@PUBLIC_ORIGIN@",
      "baseUrl": "@PUBLIC_ORIGIN@/",
      "redirectUris": ["@PUBLIC_ORIGIN@/auth/callback"],
      "webOrigins": ["@PUBLIC_ORIGIN@"],
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "@PUBLIC_ORIGIN@/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "finance-rag audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "finance-rag",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "RAG",
      "lastName": "Admin",
      "credentials": [{"type": "password", "value": "@RAG_ADMIN_PASSWORD@", "temporary": false}],
      "realmRoles": ["admin"]
    },
    {
      "username": "rag-visitor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "RAG",
      "lastName": "Visitor",
      "credentials": [{"type": "password", "value": "@RAG_VISITOR_PASSWORD@", "temporary": true}],
      "realmRoles": ["visitor"]
    }
  ]
}
