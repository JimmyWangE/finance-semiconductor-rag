# Stage 1: set oidc only after HTTPS callback and IdP client registration are ready.
RAG_AUTH_MODE=oidc
RAG_SESSION_SECRET_FILE=/run/secrets/rag_session_secret
RAG_SESSION_TTL_SECONDS=28800
RAG_OIDC_ISSUER=https://sso.example.internal
RAG_OIDC_CLIENT_ID=finance-semiconductor-rag
RAG_OIDC_CLIENT_SECRET_FILE=/run/secrets/rag_oidc_client_secret
RAG_OIDC_REDIRECT_URI=https://finance.example.internal/auth/callback
RAG_PUBLIC_ORIGIN=https://finance.example.internal
RAG_OIDC_SCOPES=openid profile email groups
RAG_OIDC_ADMIN_GROUPS=finance-rag-admins
RAG_OIDC_ADMIN_SUBJECTS=

# Stage 2
RAG_LOG_FORMAT=json
RAG_LOG_LEVEL=INFO
RAG_METRICS_TOKEN=replace-with-monitoring-secret
RAG_BUILD_VERSION=development

# Stage 3: sqlite is the rollback value; postgres requires both services.
RAG_TASK_BACKEND=postgres
RAG_DATABASE_URL=postgresql://rag_app@postgres.internal:5432/finance_rag
RAG_REDIS_URL=redis://redis.internal:6379/0
RAG_REDIS_STREAM=rag:tasks
RAG_REDIS_GROUP=rag-workers
RAG_WORKER_ID=replace-per-instance
RAG_TASK_LEASE_SECONDS=60
FINANCE_AGENT_MAX_PENDING=20
